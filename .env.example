# Contoh konfigurasi environment untuk docker-compose.dev.yml (root).
# Salin ke `.env` (di root, sudah di-.gitignore) untuk dev lokal.
# JANGAN commit `.env` atau kredensial/secret asli apa pun. Semua nilai di
# bawah ini adalah default/placeholder DEV-ONLY.

# --- PostgreSQL (XC-02) ---
POSTGRES_USER=frac
POSTGRES_PASSWORD=frac_dev_password
POSTGRES_DB=frac
POSTGRES_PORT=5432

# --- Redis (XC-02) ---
REDIS_PORT=6379

# --- MinIO — S3-compatible stand-in for MLflow artifacts + local S3 testing
#     in dev/CI only. Staging/prod use real AWS S3 (bucket provisioned
#     MANUALLY oleh user — lihat infra/terraform/README.md); nilai di bawah
#     TIDAK dipakai untuk AWS asli. (XC-02) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- MailHog — dev-only fake SMTP server for the forgot-password flow
#     (BE-03 follow-up). Accepts any message without real delivery; view
#     what was "sent" at http://localhost:8025. ---
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

# --- MLflow (XC-02) ---
MLFLOW_PORT=5000
MLFLOW_BACKEND_STORE_URI=postgresql://frac:frac_dev_password@postgres:5432/mlflow
MLFLOW_ARTIFACT_ROOT=s3://mlflow/
MLFLOW_S3_ENDPOINT_URL=http://minio:9000

# --- AWS S3 (media bucket, XC-03) ---
# Bucket provisioned MANUALLY oleh user (lihat infra/terraform/README.md);
# isi nilai di bawah dari hasil provisioning tsb. Nilai di sini hanya
# placeholder — JANGAN isi kredensial asli di file .env.example ini.
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=frac-media
AWS_S3_PREFIX=face-recognition/
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme
# Dev/test ONLY (BE-06): point boto3 at an S3-compatible endpoint (e.g. MinIO
# from docker-compose.dev.yml) instead of real AWS. Leave unset/commented in
# staging/prod.
# AWS_S3_ENDPOINT_URL=http://localhost:9000
