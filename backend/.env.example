# Contoh konfigurasi environment — salin ke .env (JANGAN commit .env / secret apa pun).
APP_ENV=dev
APP_NAME=frac-backend
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Diisi pada task XC-02/BE-02 dst. (nilai nyata via secret manager / .env lokal):
# Driver: psycopg (v3). Lihat backend/README.md "Database & migrasi (BE-02)".
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/frac
# REDIS_URL=redis://localhost:6379/0

# --- AWS S3 (media bucket, XC-03) ---
# Bucket "frac-media" diprovision MANUAL oleh user (lihat infra/terraform/README.md),
# BUKAN oleh aplikasi/agent ini. Isi field di bawah dari hasil provisioning tsb.
# JANGAN isi kredensial asli di file .env.example ini — placeholder saja.
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=frac-media
AWS_S3_PREFIX=face-recognition/
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme

# --- Staff AuthN/AuthZ (BE-03) ---
# Local email+password JWT login against staff_accounts (RBAC ADMIN/OPERATOR/VIEWER).
# JWT_SECRET_KEY WAJIB diganti per-lingkungan (generate mis. `openssl rand -hex 32`)
# via env/secret manager — JANGAN pernah pakai nilai placeholder ini di luar dev lokal.
JWT_SECRET_KEY=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080
