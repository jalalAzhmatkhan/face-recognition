# Claude Code (tidak di-commit, di-ignore juga oleh graphify)
.claude/
.kilo/

# Documentation: hanya FSD dan TSD yang di-commit
documentation/*
!documentation/fsd/
!documentation/tsd/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
build/
.next/

# Rust
target/

# ML artifacts (media & model tidak boleh di repo; media wajib di S3)
*.pt
*.pth
*.onnx
*.ckpt
*.h5
# MiniFASNet liveness weights (IN-04): kecil (~1.8MB masing-masing) & Apache-2.0,
# tidak ada masalah lisensi/prosedur unduh seperti AdaFace — commit langsung,
# presenden sama dengan ai-training/models/face_landmarker.task.
!ai-training/models/2.7_80x80_MiniFASNetV2.pth
!ai-training/models/4_0_0_80x80_MiniFASNetV1SE.pth
data/
datasets/
*.mp4
*.avi
*.mov
*.jpg
*.jpeg
*.png
!frontend/**/assets/**
mlruns/
wandb/

# Env & secrets
.env
.env.*
!**/.env.example
*.pem

# Terraform (infra/terraform/): never commit state or real tfvars, only the
# *.tfvars.example template (XC-03)
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log

# OS/IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

graphify-out/